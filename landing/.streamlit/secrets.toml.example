# Copia este archivo a secrets.toml (no se sube a git).
# Gmail: usa una «contraseña de aplicación» (16 caracteres), no la contraseña normal de la cuenta.
# Se crea en https://myaccount.google.com/apppasswords (requiere verificación en dos pasos activada).
[smtp]
host = "smtp.gmail.com"
port = 465
user = "cloud.ai.champions@gmail.com"
password = "xxxx xxxx xxxx xxxx"
to = "cloud.ai.champions@gmail.com"   # buzón que recibe las solicitudes
